{
  "name": "dsh-ssh",
  "version": "0.1.0",
  "description": "DSH 侧边栏 SSH 终端与会话授权远程操作",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "engines": { "node": ">=22.19.0", "dsh": "^0.2.1-rc.2 || ^0.2.1-alpha.4" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-api-session-controller"] }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "test:ui": "node scripts/verify-ui.mjs",
    "test:ssh": "node scripts/verify-ssh.mjs",
    "test:host": "node scripts/verify-host.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.4 || 4.0.5-alpha.2", "@deepseek-ai/dsh-tools": "^0.2.1-rc.2 || ^0.2.1-alpha.4", "react": "^18.2.0" },
  "devDependencies": { "esbuild": "0.28.1", "react": "18.3.1", "react-dom": "18.3.1", "@playwright/test": "1.62.0", "@xterm/xterm": "6.0.0", "@xterm/addon-fit": "0.11.0" }
}
